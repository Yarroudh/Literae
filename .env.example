# Literae API
APP_NAME="Literae API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"

# JSON array of browser origins allowed to call the API.
CORS_ORIGINS='["http://localhost:3000"]'

# DeepSeek
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-pro"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_TIMEOUT_SECONDS=30

# OpenAlex
OPENALEX_BASE_URL="https://api.openalex.org"
OPENALEX_API_KEY=""
OPENALEX_EMAIL=""
OPENALEX_RESULTS_LIMIT=10
OPENALEX_TIMEOUT_SECONDS=15
OPENALEX_CACHE_TTL_SECONDS=300
SERVICE_RETRY_ATTEMPTS=3

# PostgreSQL history. Docker Compose constructs DATABASE_URL from these values.
POSTGRES_DB="literae"
POSTGRES_USER="literae"
POSTGRES_PASSWORD="change-this-password"
DATABASE_URL="postgresql://literae:change-this-password@localhost:5432/literae"
HISTORY_ENABLED=true

# Published ports and browser-visible API endpoint.
FRONTEND_PORT=3000
API_PORT=8000
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Optional developer tracing. Leave empty to keep Laminar disabled.
LMNR_PROJECT_API_KEY=""
LMNR_BASE_URL=""
LAMINAR_FORCE_HTTP=true
LAMINAR_DISABLE_BATCH=true
